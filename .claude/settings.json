{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./venv/**)",
      "Read(./.idea/**)",
      "Read(./test-results/**)",
      "Read(./graphify-out/cache/**)",
      "Read(./**/*.log)",
      "Read(./android/build/**)",
      "Read(./android/app/build/**)",
      "Read(./android/.gradle/**)",
      "Read(./.gradle/**)",
      "Read(./**/*.apk)",
      "Read(./package-lock.json)",
      "Read(./docs/screenshots/**)",
      "Read(./coverage/**)",
      "Read(./graphify-out/**)",
      "Read(./android/.kotlin/**)",
      "Read(./**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  }
}

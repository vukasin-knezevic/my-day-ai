{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./venv/**)",
      "Read(./.idea/**)",
      "Read(./test-results/**)",
      "Read(./graphify-out/cache/**)",
      "Read(./**/*.log)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs", "timeout": 60 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/check.mjs", "timeout": 180 }]
      }
    ]
  }
}
